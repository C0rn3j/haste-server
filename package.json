{
  "name": "haste",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private Pastebin Server",
  "keywords": [
    "paste",
    "pastebin"
  ],
  "author": {
    "name": "John Crepezzi",
    "email": "john.crepezzi@gmail.com",
    "url": "http://seejohncode.com/"
  },
  "main": "haste",
  "dependencies": {
    "busboy": "^1.6.0",
    "connect": "^3.7.0",
    "connect-ratelimit": "^0.0.7",
    "connect-route": "^0.1.5",
    "jquery": "^4.0.0",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "st": "^3.0.4",
    "uglify-js": "^3.19.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "mocha": "^12.0.3"
  },
  "bundledDependencies": [],
  "bin": {
    "haste-server": "./server.js"
  },
  "files": [
    "server.js",
    "config.js",
    "about.md",
    "lib",
    "static",
    "scripts"
